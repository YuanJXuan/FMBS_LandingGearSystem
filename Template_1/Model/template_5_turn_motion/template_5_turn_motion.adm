!
!                            adams_view_name='NLG_V'
VARIABLE/115
, IC = 0
, FUNCTION = -1*VR(2,325)
!
!                            adams_view_name='LMLG_S'
VARIABLE/116
, IC = 0
, FUNCTION = 1.014262-DM(272,273)
!
!                            adams_view_name='RMLG_S'
VARIABLE/117
, IC = 0
, FUNCTION = 1.014262-DM(278,279)
!
!                            adams_view_name='LMLG_V'
VARIABLE/118
, IC = 0
, FUNCTION = -1*VR(272,273)
!
!                            adams_view_name='RMLG_V'
VARIABLE/119
, IC = 0
, FUNCTION = -1*VR(278,279)
!
!                            adams_view_name='NLG_S'
VARIABLE/120
, IC = 0
, FUNCTION = 0.4286-DM(2,325)
!
!                              adams_view_name='x1'
VARIABLE/121
, IC = 0
, FUNCTION =
, -1*(VARVAL(115)*0.5*(VARVAL(115)-ABS(VARVAL(115)))*((860.0*1.953E-02**3/(2*0.8**2*3.14E-04**2))+(860.0*6.139E-03**3/(2*0.8**2*1.0E-04**2))))
!
!                              adams_view_name='x2'
VARIABLE/122
, IC = 0
, FUNCTION =
, 0.00001*VARVAL(115)*0.5*(VARVAL(115)+ABS(VARVAL(115)))*((860.0*1.953E-02**3/(2*0.8**2*3.14E-04**2))+(860.0*6.139E-03**3/(2*0.8**2*2.313E-03**2)))
!
!                         adams_view_name='VARIABLE_123'
VARIABLE/123
, IC = 0
, FUNCTION = IF(TIME:0,1,2)
!
!                         adams_view_name='VARIABLE_124'
VARIABLE/124
, IC = 0
, FUNCTION = VARVAL(115)-ABS(VARVAL(115))
!
!                            adams_view_name='jiaodu'
VARIABLE/125
, FUNCTION = AZ(370,307)*180/pi-180
!
!                           adams_view_name='jscm_sd'
VARIABLE/126
, FUNCTION = VM(438,0)
!
!                             adams_view_name='jsd'
VARIABLE/127
, FUNCTION = wz(370,307)*30/pi
!
